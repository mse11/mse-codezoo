  "$ref": "#/$defs/Program",
  "$defs": {
    "Expr": {
      "oneOf": [
        {
          "$ref": "#/$defs/Const"
        },
        {
          "$ref": "#/$defs/Name"
        },
        {
          "$ref": "#/$defs/Call"
        },
        {
          "$ref": "#/$defs/BinOp"
        },
        {
          "$ref": "#/$defs/UnaryOp"
        }
